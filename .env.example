# Prefer: node scripts/configure.mjs (generates unique secrets in .env).
# That script writes every uncommented variable below; keep the two lists in step.
POSTGRES_PASSWORD=
SETUP_TOKEN=
MOHUA_BIND_ADDRESS=127.0.0.1
MOHUA_PORT=3210
OFFICIAL_PUSH_GATEWAY_URL=
# Gateway application ID. Kookaburra Relay 0.3.0+ no longer creates a default
# application: create one with this ID in the gateway console. Must match the client build.
PUSH_GATEWAY_APP_ID=mohua
# Proxies in front of the server that append X-Forwarded-For. Compose's edge counts as 1;
# use 2 if another reverse proxy or tunnel forwards to the edge with X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
# Local Node development (provide your own database connection):
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/mohua

# Prebuilt deployment: use the actual GitHub owner/repository, in lowercase.
# MOHUA_IMAGE=ghcr.io/owner/repository:latest

# Generated by scripts/configure.mjs; internal mail broker only
MAIL_BROKER_TOKEN=

# Approved server identity; keep secret. Origin must match the gateway receiving it.
GATEWAY_SERVER_CREDENTIAL=
GATEWAY_SERVER_CREDENTIAL_URL=
